# ===================================================================
# Starfit 后端环境变量示例（backend/.env.local）
# 复制为 .env.local 并填入真实值。docker-compose.yml 通过 env_file 读取本文件。
# ===================================================================
#
# -------------------------------------------------------------------
# ★ 最小可启动清单（改这 4 项即可跑起来）
# -------------------------------------------------------------------
#   1. DATABASE_URL          —— PostgreSQL 连接串 [SECRET]
#   2. STARFIT_ACCESS_TOKEN  —— API 访问令牌（任意随机长字符串）[SECRET]
#   3. DEEPSEEK_API_KEY      —— 默认 LLM provider 密钥 [SECRET]
#   4. DEEPSEEK_BASE_URL     —— DeepSeek 兼容网关地址
# （AI_PROVIDER 默认 glm；用 glm 时改填 GLM_BASE_URL/GLM_MODEL，
#   用 google 时改填 GOOGLE_API_KEY。）
# -------------------------------------------------------------------

# ---------------- 必需 ----------------

# PostgreSQL 连接串（唯一真源；PGHOST/PGUSER 等零散变量仅在不设此串时生效）
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/starfit

# API 访问令牌：客户端请求必须携带；未设置时服务启动即拒绝 [SECRET]
STARFIT_ACCESS_TOKEN=CHANGE_ME

# 默认 LLM provider，合法枚举：glm | deepseek | openai | google
# 优先级：DB 配置 > 本变量 > 代码默认
AI_PROVIDER=deepseek

# DeepSeek（当前默认 provider）：密钥 [SECRET] / 兼容网关 / 快速任务模型
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=CHANGE_ME
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash-ga-260731

# GLM provider（AI_PROVIDER=glm 时必填）
GLM_BASE_URL=
GLM_MODEL=

# Google Gemini provider（AI_PROVIDER=google 时必填）[SECRET]
GOOGLE_API_KEY=CHANGE_ME

# OpenAI provider（AI_PROVIDER=openai 时填）[SECRET]
OPENAI_API_KEY=
# OpenAI 兼容网关（缺省 https://api.openai.com/v1）
OPENAI_BASE_URL=
OPENAI_MODEL=
# HTTP(S) 代理兜底：preload 启动时若配置了 provider 代理会回写这两个变量，一般无需手填
HTTP_PROXY=
HTTPS_PROXY=

# 视觉理解模型（餐食拍照识别等）：密钥/网关/模型名 [SECRET]
# 回退链：DB 配置 > VISION_* > DEEPSEEK_*
VISION_API_KEY=CHANGE_ME
VISION_BASE_URL=
VISION_MODEL=doubao-seed-2-1-turbo-260628

# Google GenAI 模型名（google provider 使用；缺省 gemini-3-flash-preview）
GOOGLE_GENAI_MODEL=
GEMINI_MODEL=

# Gemini 专用代理（google/openai provider 出网走此代理，留空直连）
GEMINI_PROXY=
# OpenAI 专用代理
OPENAI_PROXY=
# 全局 LLM 出网代理兜底（provider 专用代理未设时生效）
GLOBAL_PROXY=

# ---------------- 可选 ----------------

# 服务监听（容器内由 compose 强制 0.0.0.0:43111，本地开发可改）
HOST=127.0.0.1
PORT=43111

# 运行环境：development | production（影响错误堆栈暴露与日志格式）
NODE_ENV=development

# 日志级别：debug | info | warn | error（缺省 info）
LOG_LEVEL=info

# 动作建议（POST /api/suggestions）：off=纯公式（默认）| hybrid=公式+Agent 有界调整
SUGGESTION_AGENT_MODE=off
# hybrid 模式下 Agent 调整的超时毫秒数（缺省 12000）
SUGGESTION_AGENT_TIMEOUT_MS=12000

# 教练人设：professional（默认）等，DB 配置可覆盖
COACH_PERSONA=professional
# 提示词风格：default（默认）等，DB 配置可覆盖
PROMPT_STYLE=default

# 生成海报是否落盘保存（true 时写入 uploads/）
PERSIST_POSTER=true

# 图片生成 provider/model/网关/密钥（不填则禁用图片生成）[SECRET]
IMAGE_GEN_PROVIDER=
IMAGE_GEN_MODEL=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=

# ---------------- PostgreSQL 散接参数（仅 DATABASE_URL 未设时生效） ----------------

PGHOST=localhost
PGPORT=5432
PGDATABASE=starfit
PGUSER=starfit
PGPASSWORD=CHANGE_ME
# 连接池
PGPOOL_SIZE=20
PGPOOL_MIN=2
PGIDLE_TIMEOUT=30000
PGCONNECTION_TIMEOUT=2000
# SSL：disabled | prefer | require 等；rejectUnauthorized 设 0 跳过证书校验
PGSSLMODE=
PGSSLREJECTUNAUTHORIZED=1
# 客户端证书三件套（云托管 PG 用）[SECRET]
PGCA=
PGCERT=
PGKEY=

# ---------------- 开发/测试专用（生产保持注释） ----------------

# 特性开关：HTTP Live Sync 与 Redis 均为历史开关，当前代码未实现对应能力，保持 false
HLS_ENABLED=false
REDIS_ENABLED=false

# 打桩模式：LLM 返回占位内容而非真实调用（本地冒烟用）
DEBUG_PLACEHOLDER=false

# 对接探测脚本（scripts/docking/runProbes.ts）专用
BACKEND_BASE=http://localhost:43111
WS_URL=
# 探测是否访问真实环境
R5_PROBE_LIVE=false

# 测试数据库连接串（仅 MCP/集成测试用）[SECRET]
MCP_TEST_DB_URL=
