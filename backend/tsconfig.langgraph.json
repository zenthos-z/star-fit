{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "#*": ["./src/*"],
      "shared/*": ["../shared/*"]
    },
    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../shared"]
}
