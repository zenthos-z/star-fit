{
  "name": "starfit-agent-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:shared && tsx src/preload.ts",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "build:shared": "cd ../shared && npm run build",
    "start": "node dist/preload.js",
    "test": "tsx --test tests/*.ts",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:contract": "tsx --test tests/contract-tests.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:profile": "node --test backend/tests/e2e/userProfileEdit.test.mjs",
    "test:workflow": "jest tests/integration/completeUserWorkflow",
    "test:workflow:postgres": "TEST_DB_TYPE=postgres jest tests/integration/completeUserWorkflow",
    "migrate:schema": "tsx src/scripts/migrateSchema.ts",
    "migrate:exercises": "tsx src/scripts/migrateExercises.ts",
    "docking:scan": "tsx src/scripts/docking/scanContracts.ts",
    "docking:probes": "tsx src/scripts/docking/runProbes.ts",
    "reset:testdata": "tsx src/scripts/resetTestData.ts",
    "db:seed": "tsx src/scripts/seedExercises.ts",
    "db:init-exercises": "npm run db:seed",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "lint:data-format": "node scripts/lint/check-data-format.mjs",
    "lint:state-race": "node scripts/lint/check-state-race.mjs",
    "lint:api-consistency": "node scripts/lint/check-api-consistency.mjs",
    "lint:all": "npm run lint:data-format && npm run lint:state-race && npm run lint:api-consistency",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/postgresql/migrations/run.ts migrate",
    "db:migrate:dry": "tsx src/db/postgresql/migrations/run.ts dry",
    "db:migrate:status": "tsx src/db/postgresql/migrations/run.ts status",
    "db:migrate:validate": "tsx src/db/postgresql/migrations/validate.ts validate",
    "db:migrate:list": "tsx src/db/postgresql/migrations/validate.ts list",
    "lint:log-tags": "tsx src/scripts/migrate-log-tags.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^0.9.0",
    "@langchain/core": "^1.2.2",
    "@langchain/google-genai": "^2.1.13",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/openai": "^1.2.3",
    "@sentry/node": "^10.34.0",
    "@sentry/types": "^10.34.0",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "deepagents": "^1.10.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.2",
    "fs-extra": "^11.3.3",
    "ioredis": "^5.9.3",
    "langchain": "^1.5.3",
    "langsmith": "^0.8.1",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "react-window": "^2.2.5",
    "undici": "^7.16.0",
    "ws": "^8.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.12",
    "@playwright/test": "^1.57.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
