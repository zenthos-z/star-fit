# ===================================================================
# Starfit 自部署环境变量示例（deploy/.env）
# 用法：cp deploy/.env.example deploy/.env ，然后逐项填写。
# docker-compose.prod.yml 通过 env_file 读取本文件（postgres/backend/migrate 三个服务共用）。
#
# ★ 敏感项标 [SECRET]：占位 CHANGE_ME，建议由部署 Agent 用
#   `openssl rand -base64 18` 之类命令生成随机值后就地替换。
#
# -------------------------------------------------------------------
# ★ 必填清单（不填服务起不来 / 起来了不可用）
# -------------------------------------------------------------------
#   1. POSTGRES_PASSWORD     —— 数据库口令 [SECRET]（同时拼进 DATABASE_URL）
#   2. DATABASE_URL          —— 后端连库串（把下面的 CHANGE_ME 换成第 1 项的值）
#   3. STARFIT_ACCESS_TOKEN  —— API 访问令牌 [SECRET]（App 登录时要填）
#   4. AI provider 密钥      —— DEEPSEEK_API_KEY 或 GLM_API_KEY 等 [SECRET]
# -------------------------------------------------------------------

# ---------------- Compose 编排变量 ----------------

# 宿主机映射端口（默认 43111；被占用时可改，App 登录页填对应端口即可）
STARFIT_PORT=43111

# ---------------- PostgreSQL（postgres 容器初始化用） ----------------

POSTGRES_USER=starfit
# 数据库口令 [SECRET] → CHANGE_ME（建议部署 Agent 生成随机值）
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=starfit

# ---------------- 后端核心（必填） ----------------

# PostgreSQL 连接串（容器内通过服务名 postgres 访问；口令与上面 POSTGRES_PASSWORD 保持一致）
DATABASE_URL=postgresql://starfit:CHANGE_ME@postgres:5432/starfit

# API 访问令牌：App 登录页必填；随机长字符串 [SECRET] → CHANGE_ME（建议部署 Agent 生成）
STARFIT_ACCESS_TOKEN=CHANGE_ME

# 默认 LLM provider，合法枚举：glm | deepseek | openai | google
# 优先级：DB 配置 > 本变量 > 代码默认
AI_PROVIDER=deepseek

# DeepSeek（当前默认 provider）：密钥 [SECRET] / 兼容网关 / 快速任务模型
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=CHANGE_ME
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash-ga-260731

# GLM provider（AI_PROVIDER=glm 时必填）[SECRET]
GLM_BASE_URL=
GLM_MODEL=

# Google Gemini provider（AI_PROVIDER=google 时必填）[SECRET]
GOOGLE_API_KEY=CHANGE_ME

# OpenAI provider（AI_PROVIDER=openai 时填）[SECRET]
OPENAI_API_KEY=
# OpenAI 兼容网关（缺省 https://api.openai.com/v1）
OPENAI_BASE_URL=
OPENAI_MODEL=

# 视觉理解模型（餐食拍照识别等）：密钥/网关/模型名 [SECRET]
# 回退链：DB 配置 > VISION_* > DEEPSEEK_*
VISION_API_KEY=CHANGE_ME
VISION_BASE_URL=
VISION_MODEL=doubao-seed-2-1-turbo-260628

# Google GenAI 模型名（google provider 使用；缺省 gemini-3-flash-preview）
GOOGLE_GENAI_MODEL=
GEMINI_MODEL=

# ---------------- 可选（留空即用默认值） ----------------

# 日志级别：debug | info | warn | error（缺省 info）
LOG_LEVEL=info

# 动作建议（POST /api/suggestions）：off=纯公式（默认）| hybrid=公式+Agent 有界调整
SUGGESTION_AGENT_MODE=off
# hybrid 模式下 Agent 调整的超时毫秒数（缺省 12000）
SUGGESTION_AGENT_TIMEOUT_MS=12000

# 教练人设 / 提示词风格（DB 配置可覆盖）
COACH_PERSONA=professional
PROMPT_STYLE=default

# 生成海报是否落盘保存（true 时写入 uploads 卷）
PERSIST_POSTER=true

# 图片生成 provider/model/网关/密钥（不填则禁用图片生成）[SECRET]
IMAGE_GEN_PROVIDER=
IMAGE_GEN_MODEL=
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=

# 代理兜底（provider 专用代理，留空直连）
GEMINI_PROXY=
OPENAI_PROXY=
GLOBAL_PROXY=

# ---------------- 其余 PG 散接参数（DATABASE_URL 已设时一般无需动） ----------------

PGPOOL_SIZE=20
PGPOOL_MIN=2
PGIDLE_TIMEOUT=30000
PGCONNECTION_TIMEOUT=2000

# ---------------- 生产保持注释 / 保持 false ----------------

# 历史特性开关，当前代码未实现对应能力，保持 false
HLS_ENABLED=false
REDIS_ENABLED=false
# 打桩模式：LLM 返回占位内容（仅本地冒烟用，生产必须 false）
DEBUG_PLACEHOLDER=false
